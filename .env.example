# ══════════════════════════════════════════════════════════════════════════════
#  Nightmarket — the one environment file.
#
#  Don't copy this by hand. Run:
#
#      pnpm run setup:env
#
#  which splits it into apps/api/.env and apps/mobile/.env, fills in everything a
#  machine can derive (attestation keypair, your LAN address) or copy across
#  (integration address, Privy app id), and prints the short list of what only you
#  can supply. It never overwrites a value you typed,
#  so it is safe to re-run — and re-running after a `git pull` appends any keys
#  that were added here without touching the rest.
#
#  The `# ==>` lines below are the split markers. Everything after one belongs to
#  that file, comments included.
# ══════════════════════════════════════════════════════════════════════════════


# ==> apps/api/.env
# ──────────────────────────────────────────────────────────────────────────────
#  The Yodl integration backend.
# ──────────────────────────────────────────────────────────────────────────────

PORT=8787

# Your registered Yodl integration address. Deliveries addressed elsewhere are
# rejected before the signature is even checked, so this must match the mobile
# app's copy below — setup:env keeps the two in step for you.
#
# Left unset, setup:env fills in the sample address from Yodl's own docs so the
# local webhook replay works out of the box. That is a working default, not your
# integration: https://docs.yodl.me/integrations/integration-address
YODL_INTEGRATION_ADDRESS=0x0000000000000000000000000000000000000000

# HMAC key for X-Yodl-Signature. This is NOT the API secret — it is never
# transmitted, and it only ever proves a webhook came from Yodl.
# Defaults to the secret from the docs' worked example so the local
# scripts/send-webhook.ts replay works out of the box.
YODL_WEBHOOK_SIGNING_SECRET=integration-example-secret

# HTTP Basic password for api.yodl.me. Travels on every request; anything
# holding it can read every payment made through your integration, so it stays
# server-side and never reaches the app. Leave unset and /v1/yodl/payments
# returns 501 instead of half-working.
YODL_API_SECRET=
YODL_API_BASE_URL=https://api.yodl.me

# Email attestation. setup:env generates these; to rotate by hand:
#   pnpm --filter @nightmarket/api keygen
#
# The key is a PKCS#8 PEM, base64-encoded onto one line. Base64 because a PEM is
# multi-line and .env parsers disagree about newlines — Node's --env-file keeps
# \n as a literal backslash-n rather than unescaping it, so the obvious
# "escape the newlines" form imports as a corrupt key.
#
# Leave unset and the route 404s, which fetchEmailAttestation reads as
# "no attestation available" — the user just takes the normal OTP.
YODL_ATTESTATION_PRIVATE_KEY=
YODL_ATTESTATION_KID=nightmarket-dev

# Reusable KYC, donor side. Nightmarket's users verify against *our* Sumsub
# sandbox tenant; POST /v1/kyc/:wallet/share-token then mints the single-use
# token the Yodl SDK's KYC callback hands to Yodl, whose tenant copies the
# verification instead of re-running document capture.
#
# Sandbox credentials only (the token must start with "sbx:") — the simulate
# route fabricates approvals, which belongs nowhere near production. Grab a
# pair at https://cockpit.sumsub.com/checkus/devSpace/appTokens with the
# workspace toggled to Sandbox. Leave unset and /v1/kyc answers 501.
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=

# The donor verification level (must exist in the sandbox workspace) and the
# recipient tenant share tokens are minted for.
SUMSUB_LEVEL_NAME=id-and-liveness
SUMSUB_SHARE_FOR_CLIENT_ID=yodlpay.com

# Attestation's other half: who is asking.
#
# Signing is the easy part. Knowing whose email you are entitled to assert is the
# whole thing — so the route verifies the caller's Privy access token against the
# JWKS Privy publishes for this app, and then reads the email Privy has on file
# for that user. Nothing in the request body is believed. Leave either of these
# unset and there is no way to tell one caller from another, so the route declines
# every request and the user takes the normal OTP.
#
# PRIVY_APP_ID is the same public identifier the app ships as
# EXPO_PUBLIC_PRIVY_APP_ID below, and setup:env copies it across so the two cannot
# drift. PRIVY_APP_SECRET is the one that matters: it is the HTTP Basic password
# for api.privy.io, it can read every user in your app, and it must never reach
# the bundle. There is no EXPO_PUBLIC_ twin of it for that reason.
#
# https://dashboard.privy.io → your app → App settings → Basics
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Where payments are persisted. ':memory:' disables the file.
NIGHTMARKET_DATA_FILE=.data/store.json

# Plant a few night-market stalls on first boot so the app has a feed before a
# real webhook ever lands.
NIGHTMARKET_SEED=1


# ==> apps/mobile/.env
# ──────────────────────────────────────────────────────────────────────────────
#  The Expo scanner.
#
#  EXPO_PUBLIC_* is inlined into the bundle at build time. That is fine for all
#  four values here — a Privy app id and a Yodl integration address are public
#  identifiers, not credentials. The one real secret in this system, the Yodl API
#  secret, lives only in apps/api. If you ever want it here, that is the signal to
#  add an endpoint to the API instead.
#
#  Changing any of these needs a bundler restart: they are compiled in, and a
#  running Metro will not pick up the edit.
# ──────────────────────────────────────────────────────────────────────────────

# https://dashboard.privy.io → your app → Clients
#
# A mobile app needs BOTH. The client id is what authorises a non-web platform to
# call the Privy API, and login fails in a confusing way with only the app id.
# setup:env cannot derive these — they are the one thing it will ask you for.
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=

# The integration address handed to createYodlSdk(). Must match the API's copy above;
# setup:env propagates whichever one you set.
EXPO_PUBLIC_YODL_INTEGRATION_ADDRESS=0x0000000000000000000000000000000000000000

# Where apps/api is reachable *from the device*. On a simulator localhost works;
# on a physical phone localhost is the phone, so setup:env replaces this with
# your machine's LAN address — e.g. http://192.168.1.42:8787
EXPO_PUBLIC_API_URL=http://localhost:8787
