# Metro (React Native's bundler) does not follow pnpm's symlinked, isolated
# node_modules reliably. Hoisting is the supported layout for Expo + pnpm.
# https://docs.expo.dev/guides/monorepos/
node-linker=hoisted

# Keep peer resolution loose: Privy pins several Expo peers that Expo SDK 57
# satisfies with a different patch line.
strict-peer-dependencies=false
auto-install-peers=true
