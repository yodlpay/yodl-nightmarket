# Metro (React Native's bundler) does not follow pnpm's symlinked, isolated
# node_modules reliably. Hoisting is the supported layout for Expo + pnpm.
# https://docs.expo.dev/guides/monorepos/
node-linker=hoisted

# Keep peer resolution loose. Openfort pins its own Expo peers as `*` and is
# satisfied either way; the rest of the Expo SDK 57 graph is what still needs
# this, pinning peers to patch lines the installed versions do not match.
strict-peer-dependencies=false
auto-install-peers=true
